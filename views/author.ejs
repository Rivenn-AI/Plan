<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.min.js"></script>
    <title>Portfolio</title>
</head>

<body>
<div class ="frame">
      <div class="main_frame">
        <div class="left_frame">
            <div class="left_1">
                <div class="left_1-1">
                    <img src="images/profile.png" 
                    width="156px"
                    height="142px"
                     alt="">
                </div>
                <div class="left_1-2">  <%=user.name%> </div>
                <div class="left_1-3"> <%=user.profession%></div>
                <div class="left-icons">
                    <a class = "link_href" href="">
                        <div class="icon">
                            <img src="icon/Facebook.png" class="icon-1"/>                        </div>
                    </a>
                    <a class = "link_href" href="">
                        <div class="icon">
                            <img src="icon/Instagram.png" class="icon-1"/>                        </div>
                    </a>
                    <a class = "link_href" href="">
                        <div class="icon">
                            <img src="icon/Linkeding.png" class="icon-1"/>                        </div>
                    </a>
                    <a class = "link_href" href="">
                        <div class="icon">
                            <img src="icon/Youtube.png" class="icon-1"/>                        </div>
                    </a>
                    <a class = "link_href" href="">
                        <div class="icon">
                            <img src="icon/Twitter.png" class="icon-1"/>                        </div>
                    </a>
                    <a class = "link_href" href="">
                        <div class="icon">
                            <img src="icon/Facebook.png" class="icon-1"/>                        </div>
                    </a>
                </div>
            </div>
            <div class="marginer"></div>

            <div class="left_2">
                <div class="left_2-1">
                    <div class="ages">
                        <span class="age_1">Age:</span>
                         <span class="age_2"><%=user.age%></span>
                    </div>
                </div>
                <div class="left_2-2">
                    <div class="residence">
                        <span class="residence_1">Recidence:</span>
                         <span class="residence_2"><%=user.residence%></span>
                    </div>
                </div>
                <div class="left_2-3">
                    <div class="freelance">
                        <span class="freelance_1">Freelance:</span>
                         <span class="freelance_2"><%=user.freelance%></span>
                    </div>
                </div>
                <div class="left_2-4">
                    <div class="address">
                        <span class="address_1">Address:</span>
                         <span class="address_2"><%=user.address%></span>
                    </div>
                </div>
            </div>
            <div class="marginer"></div> 
            <div class="left_3"> 
                <div class="language" >LANGUAGES:</div>
                <div class="left_3-1">
                    <div class="uzbek">
                        <span class="uzbek_1"><%=user.languages[0]%></span>
                         <span class="uzbek_2">100%</span>
                    </div>
                </div>
                 <div class="bar">
                    <div class="progress_1"></div>
                </div>
                <div class="left_3-2">
                    <div class="english">
                        <span class="english_1"><%=user.languages[1]%></span>
                         <span class="english_2">80%</span>
                    </div>
                </div>
                <div class="bar">
                         <div class="progress_2"></div>
                         </div>
                <div class="left_3-3">
                    <div class="korean">
                        <span class="korean_1"><%=user.languages[2]%></span>
                         <span class="korean_2">40%</span>
                    </div>
                </div>
                <div class="bar">
                    <div class="progress_3"></div>
                </div>
                
            </div>
            <div class="marginer"></div> 
            <div class="left_4">
                <div class="skills" >SKILLS:</div>
                <div class="left_4-1">
                    <div class="html">
                        <span class="html_1"><%=user.skills[0]%></span>
                         <span class="html_2">70%</span>
                    </div>
                </div>
                <div class="bar">
                    <div class="html_prog"></div>
                </div>
                <div class="left_4-2">
                    <div class="css">
                        <span class="css_1"><%=user.skills[1]%></span>
                         <span class="Css_2">70%</span>
                    </div>
                </div>
                <div class="bar">
                    <div class="css_prog"></div>
                </div>
                <div class="left_4-3">
                    <div class="js">
                        <span class="js_1"><%=user.skills[2]%></span>
                         <span class="js_2">30%</span>
                    </div>
                </div>
                <div class="bar">
                    <div class="js_prog"></div>
                </div>
                <div class="left_4-4">
                    <div class="nodejs">
                        <span class="nodejs_1"><%=user.skills[3]%></span>
                         <span class="nodejs_2">50%</span>
                    </div>
                </div>
                <div class="bar">
                    <div class="nodejs_prog"></div>
                </div>
                <div class="left_4-5">
                    <div class="python">
                        <span class="python_1"><%=user.skills[4]%></span>
                         <span class="python_2">10%</span>
                    </div>
                </div>
                <div class="bar">
                    <div class="python_prog"></div>
                </div>
            </div>
            <div class="marginer"></div> 
            <div class="left_5">
                <div class="extra_skills" >EXTRA SKILLS:</div>
                <div class="extra_1">
                    <span class="box"><img src="icon/box1.jpg"></span>
                    <span ><%=user.extra_skills[0]%>,</span>
                    <span ><%=user.extra_skills[1]%></span>
                </div>
                <div class="extra_2">
                    <span class="box"><img src="icon/box1.jpg"></span>
                    <span ><%=user.extra_skills[2]%>,</span>
                    <span ><%=user.extra_skills[3]%>,</span>
                     <span ><%=user.extra_skills[4]%></span>
                </div>
                <div class="extra_3">
                    <span class="box"><img src="icon/box1.jpg"></span>
                    <span ><%=user.extra_skills[5]%>,</span>
                    <span ><%=user.extra_skills[6]%></span>
                </div>
            </div>
            <div class="marginer"></div> 
            <div class="nav_button">
                <img src="box_images/CV2.png" class="button_color">
            </div>
        </div>
        <div class="middle_frame">
            <div class="middle_1">
                 <div class="asosiy">
                    <div class="heading"><h1><%=user.work_place%></h1></div>
                    <div class="service"><%=user.service_desc%> Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ipsa, doloremque.</div>
                    <div class="hire_me">
                        <img src="box_images/hire.png">
                    </div>
                  </div>
                <div class="main_picture">
                    <img src="box_images/main.png">
                </div>
               
            </div>
            <div class="middle_2">
                <div class="second">
                            <section class="services">
                                 <h2>My Services</h2>
                                  <p>
                                   Amet Minim Mollit Non Deserunt Ullamco Est Sit Aliqua Dolor
                                  <br>
                                 Do Amet Sint. Velit Officia Consequat Duis Enim Velit Mollit.
                               <br>
                              Lorem Ipsum
                             </p>
                           </section>
                    <div class="asosiy_1"></div>
                </div>
                
            </div>
        </div>
        <div class="right_frame"></div>
      </div>
</div>
</body>

</html>
